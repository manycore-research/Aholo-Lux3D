            "type": "string",
            "description": "状态码；成功时为 \"0\"，普通参数错误时为 \"-1\"，部分业务错误使用专用错误码。",
            "nullable": true
          }
        },
        "description": "任务创建响应体。"
      }
    },
    "animation-retarget": {
      "tool": "post_createhumanoidanimationretargettask",
      "inputSchema": {
        "type": "object",
        "properties": {
          "body": {
            "type": "object",
            "required": [
              "rigModelUrl",
              "animationIds"
            ],
            "properties": {
              "contentId": {
                "type": "string",
                "description": "可选的调用方业务内容 ID，用于任务溯源。Lux3D 插件填写本次创建所依据的 quoteId。",
                "example": "quote_0123456789abcdef0123456789abcdef"
              },
              "rigModelUrl": {
                "type": "string",
                "format": "uri",
                "description": "已绑骨 GLB 模型的公网 HTTPS URL。如需上传本地文件，请先调用 [Asset 文件上传接口](https://labs.aholo3d.cn/api-docs/api-reference#tag/asset)，再将返回的 URL 填入此字段。",
                "example": "https://example.com/assets/rig-model.glb"
              },
              "animationIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "enum": [
                    "A_TPose",
                    "Dance_Loop",
                    "Idle_Rail_Call",
                    "Idle_TalkingPhone_Loop",
                    "Idle_Talking_Loop",
                    "Yes",
                    "Crouch_Idle_Loop",
                    "Idle_FoldArms_Loop",
                    "Idle_Lantern_Loop",
                    "Idle_Loop",
                    "Idle_No_Loop",
                    "Idle_Rail_Loop",
                    "Idle_Torch_Loop",
                    "ClimbUp_1m",
                    "Crouch_Fwd_Loop",
                    "Jog_Fwd_Loop",
                    "Sprint_Loop",
                    "Swim_Fwd_Loop",
                    "Swim_Idle_Loop",
                    "Walk_Formal_Loop",
                    "Walk_Loop",
                    "Jump_Land",
                    "Jump_Loop",
                    "Jump_Start",
                    "NinjaJump_Idle_Loop",
                    "NinjaJump_Land",
                    "NinjaJump_Start",
                    "Roll",
                    "Slide_Exit",
                    "Slide_Loop",
                    "Slide_Start",
                    "Sword_Attack",
                    "Sword_Block",
                    "Sword_Dash",
                    "Sword_Heavy_Combo",
                    "Sword_Idle",
                    "Sword_Regular_A",
                    "Sword_Regular_A_Rec",
                    "Sword_Regular_B",
                    "Sword_Regular_B_Rec",
                    "Sword_Regular_C",
                    "Sword_Regular_Combo",
                    "Idle_Shield_Break",
                    "Idle_Shield_Loop",
                    "Shield_Dash",
                    "Shield_OneShot",
                    "Melee_Hook",
                    "Melee_Hook_Rec",
                    "Punch_Cross",
                    "Punch_Jab",
                    "Pistol_Aim_Down",
                    "Pistol_Aim_Neutral",
                    "Pistol_Aim_Up",
                    "Pistol_Idle_Loop",
                    "Pistol_Reload",
                    "Pistol_Shoot",
                    "Spell_Simple_Enter",
                    "Spell_Simple_Exit",
                    "Spell_Simple_Idle_Loop",
                    "Spell_Simple_Shoot",
                    "Chest_Open",
                    "Consume",
                    "Driving_Loop",
                    "Farm_Harvest",
                    "Farm_PlantSeed",
                    "Farm_Watering",
                    "Fixing_Kneeling",
                    "Interact",
                    "OverhandThrow",
                    "PickUp_Table",
                    "Push_Loop",
                    "TreeChopping_Loop",
                    "Walk_Carry_Loop",
                    "LayToIdle",
                    "Sitting_Enter",
                    "Sitting_Exit",
                    "Sitting_Idle_Loop",
                    "Sitting_Talking_Loop",
                    "Death01",
                    "Hit_Chest",
                    "Hit_Head",
                    "Hit_Knockback",
                    "Zombie_Idle_Loop",
                    "Zombie_Scratch",
                    "Zombie_Walk_Fwd_Loop"
                  ]
                },
                "description": "动作 ID 列表，从以下 85 个可选值中选择 1–10 个，不可重复，区分大小写。"
              },
              "animationOutputMode": {
                "type": "string",
                "enum": [
                  "separate",
                  "combined"
                ],
                "default": "separate",
                "description": "separate 为每个动作生成一个完整文件；combined 将所选动作合并到一个文件，每个动作保留为独立动画片段。"
              },
              "outFormat": {
                "type": "string",
                "enum": [
                  "glb",
                  "fbx"
                ],
                "default": "glb",
                "description": "输出文件格式。"
              },
              "animateInPlace": {
                "type": "boolean",
                "default": false,
                "description": "是否生成原地动画。"
              }
            },
            "argsPosition": "body"
          }
        },
        "required": [
          "body"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "f": {
            "type": "object",
            "description": "失败信息；成功时为 null。",
            "nullable": true,
            "additionalProperties": true
          },
          "d": {
            "type": "integer",
            "description": "返回 taskid",
            "format": "int64",
            "example": 1256173,
            "nullable": true
          },
          "m": {
            "type": "string",
            "description": "提示信息；成功时为空字符串 \"\"。",
            "nullable": true
          },
          "c": {
            "type": "string",
            "description": "状态码；成功时为 \"0\"，普通参数错误时为 \"-1\"，部分业务错误使用专用错误码。",
            "nullable": true
          }
        },
        "description": "任务创建响应体。"
      }
    }
  }
